# Copy to .env.local and fill in what you need. Without the optional keys the
# app runs on embedded PGlite with an empty database; Google Maps search, Yelp
# search and Trustpilot discovery stay disabled until their keys are set.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase). When set, the app uses postgres-js;
# when unset, it uses PGlite on disk at PGLITE_DATA_DIR.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) URI.
# (The client sets prepare:false and max_pipeline:1, which the transaction pooler needs.)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Directory for the local PGlite database (ignored when DATABASE_URL is set).
PGLITE_DATA_DIR=.data/pglite

# --- Supabase Auth ------------------------------------------------------------
# Public by design (shipped to the browser). Sign-in requires both.
NEXT_PUBLIC_SUPABASE_URL=https://aszvhaanfiiofmzvzfub.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_toAV9lj4RpCpchmybCfMPw_QlbRioKE

# Public base URL of the deployment, e.g. https://lar.example.com.
# Used for absolute links; optional in local development.
NEXT_PUBLIC_APP_URL=

# --- Yelp Fusion --------------------------------------------------------------
# API key from https://www.yelp.com/developers/v3/manage_app. When unset, Yelp
# search is disabled ("Yelp search is not configured: set YELP_API_KEY").
YELP_API_KEY=

# --- Google Maps search (Places API (New)) ----------------------------------
# Key from a Google Cloud project with "Places API (New)" enabled (and
# optionally "Geocoding API"); restrict the key to those APIs. When unset,
# Google Maps search is disabled ("Google Maps search is not configured: set
# GOOGLE_PLACES_API_KEY") and no Google request is made.
GOOGLE_PLACES_API_KEY=
# Optional key for the Geocoding API, used only for areas that are not zip
# codes, "City, ST" or "<zip> +<n>mi". Falls back to GOOGLE_PLACES_API_KEY.
GOOGLE_GEOCODING_API_KEY=
# Most Places requests per calendar month (UTC). Searches pause when it is
# reached and say so; raise it or wait for the next month. Default 1000.
GOOGLE_PLACES_MONTHLY_REQUEST_CAP=1000

# --- Trustpilot discovery (Firecrawl) -----------------------------------------
# API key from https://firecrawl.dev. When unset, Trustpilot discovery is disabled.
FIRECRAWL_API_KEY=

# --- Email --------------------------------------------------------------------
# Resend API key. When unset, email campaigns record dry-run messages instead of sending.
RESEND_API_KEY=
# Default From header for outgoing email.
EMAIL_FROM="CRM <onboarding@resend.dev>"

# --- AI calling (ElevenLabs Agents) ------------------------------------------
# All four set → AI campaigns can place calls. ELEVENLABS_AGENT_ID is the
# template agent: every AI campaign gets its own copy of it (named "LAR · <campaign>"),
# which places that campaign's calls and is deleted with the campaign. When a copy
# cannot be made, the campaign calls through the template itself.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ElevenLabs id of the imported Twilio number (not the phone number itself).
ELEVENLABS_PHONE_NUMBER_ID=
# Secret from the agent's post-call webhook settings; the webhook route rejects unsigned events.
ELEVENLABS_WEBHOOK_SECRET=

# --- Cron ---------------------------------------------------------------------
# When set, /api/cron/* require "Authorization: Bearer <CRON_SECRET>".
# Vercel sends this header automatically for declared crons when CRON_SECRET is set.
CRON_SECRET=

# --- Display ------------------------------------------------------------------
# IANA time zone used to display timestamps (stored values are UTC).
APP_TIMEZONE=America/Chicago
