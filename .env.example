# Copy to .env.local and fill in what you need. Without the optional keys the
# app runs on embedded PGlite with an empty database; Yelp search and
# Trustpilot discovery stay disabled until their keys are set.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase). When set, the app uses postgres-js;
# when unset, it uses PGlite on disk at PGLITE_DATA_DIR.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) URI.
# (The client sets prepare:false and max_pipeline:1, which the transaction pooler needs.)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Directory for the local PGlite database (ignored when DATABASE_URL is set).
PGLITE_DATA_DIR=.data/pglite

# --- Supabase Auth ------------------------------------------------------------
# Public by design (shipped to the browser). Sign-in requires both.
NEXT_PUBLIC_SUPABASE_URL=https://aszvhaanfiiofmzvzfub.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_toAV9lj4RpCpchmybCfMPw_QlbRioKE

# Public base URL of the deployment, e.g. https://lar.example.com.
# Used for absolute links; optional in local development.
NEXT_PUBLIC_APP_URL=

# --- Yelp Fusion --------------------------------------------------------------
# API key from https://www.yelp.com/developers/v3/manage_app. When unset, Yelp
# search is disabled ("Yelp search is not configured: set YELP_API_KEY").
YELP_API_KEY=

# --- Trustpilot discovery (Firecrawl) -----------------------------------------
# API key from https://firecrawl.dev. When unset, Trustpilot discovery is disabled.
FIRECRAWL_API_KEY=

# --- Email --------------------------------------------------------------------
# Resend API key. When unset, email campaigns record dry-run messages instead of sending.
RESEND_API_KEY=
# Default From header for outgoing email.
EMAIL_FROM="CRM <onboarding@resend.dev>"

# --- Cron ---------------------------------------------------------------------
# When set, /api/cron/* require "Authorization: Bearer <CRON_SECRET>".
# Vercel sends this header automatically for declared crons when CRON_SECRET is set.
CRON_SECRET=

# --- Display ------------------------------------------------------------------
# IANA time zone used to display timestamps (stored values are UTC).
APP_TIMEZONE=America/Chicago
