# Copy to .env.local and fill in what you need. Every variable is optional;
# with none set the app runs on embedded PGlite with fixture data.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase). When set, the app uses postgres-js;
# when unset, it uses PGlite on disk at PGLITE_DATA_DIR.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) URI.
# (The client sets prepare:false and max_pipeline:1, which the transaction pooler needs.)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Directory for the local PGlite database (ignored when DATABASE_URL is set).
PGLITE_DATA_DIR=.data/pglite

# --- Yelp Fusion --------------------------------------------------------------
# API key from https://www.yelp.com/developers/v3/manage_app. Without it the
# app reads bundled fixtures from fixtures/yelp/.
YELP_API_KEY=
# "live" or "fixture". Defaults to "live" when YELP_API_KEY is set, else "fixture".
YELP_MODE=

# --- Password gate ------------------------------------------------------------
# Shared workspace password. When unset, the gate is off and every page is open.
APP_PASSWORD=
# Secret used to sign the session cookie (HMAC-SHA256). Required in production
# when APP_PASSWORD is set; a development default is used (with a warning) otherwise.
# Generate one with: openssl rand -hex 32
APP_SESSION_SECRET=

# --- Email --------------------------------------------------------------------
# Resend API key. When unset, email campaigns record dry-run messages instead of sending.
RESEND_API_KEY=
# Default From header for outgoing email.
EMAIL_FROM="CRM <onboarding@resend.dev>"

# --- Cron ---------------------------------------------------------------------
# When set, /api/cron/* require "Authorization: Bearer <CRON_SECRET>".
# Vercel sends this header automatically for declared crons when CRON_SECRET is set.
CRON_SECRET=

# --- Display ------------------------------------------------------------------
# IANA time zone used to display timestamps (stored values are UTC).
APP_TIMEZONE=America/Chicago
